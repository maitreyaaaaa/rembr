{
  "name": "@rembr/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "worker": "tsx watch src/worker/index.ts",
    "start": "node dist/index.js",
    "start:worker": "node dist/worker/index.js",
    "provision:admin": "node --import tsx scripts/provision-admin.ts",
    "smoke:meta": "node --import tsx scripts/smoke-meta-api.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts test",
    "test": "node --import tsx --test --test-concurrency=1 test/*.test.ts",
    "evaluate-search": "node --import tsx scripts/evaluate-search-relevance.ts",
    "build": "tsc"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "@zxcvbn-ts/language-common": "^4.1.3",
    "bcryptjs": "^3.0.3",
    "cheerio": "^1.2.0",
    "dotenv": "^17.4.2",
    "express": "^5.3.0",
    "express-rate-limit": "^8.3.0",
    "helmet": "^8.1.0",
    "ipaddr.js": "^2.2.0",
    "jszip": "^3.10.1",
    "multer": "^2.5.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.13",
    "@electric-sql/pglite-pgvector": "0.0.14",
    "@eslint/js": "^9.39.1",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.23.1",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.0"
  }
}
