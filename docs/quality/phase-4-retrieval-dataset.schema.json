{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rembr.app/schemas/phase-4-retrieval-dataset.schema.json",
  "title": "Rembr Phase 4 Search Relevance Dataset",
  "description": "Owner-local graded relevance judgments for evaluating Rembr keyword search. Human-reviewed and synthetic datasets are explicitly distinguished.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "judgmentSource", "description", "queries"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "judgmentSource": { "enum": ["human-reviewed", "synthetic"] },
    "description": { "type": "string", "minLength": 1, "maxLength": 500 },
    "queries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "query", "judgments"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 80 },
          "query": { "type": "string", "minLength": 1, "maxLength": 120 },
          "judgments": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2000,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["itemId", "grade"],
              "properties": {
                "itemId": { "type": "string", "format": "uuid" },
                "grade": { "type": "integer", "minimum": 0, "maximum": 3 }
              }
            }
          }
        }
      }
    }
  }
}
