NODE_ENV=development
API_PORT=4000
WEB_ORIGIN=http://127.0.0.1:5173
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional server-only key for consent-gated semantic embeddings via OpenRouter.
OPENROUTER_API_KEY=
STORAGE_BACKEND=local
# Worker-only runtime dependency for extracting temporary speech audio from video. Install a pinned FFmpeg build on the worker host.
FFMPEG_PATH=ffmpeg
SUPABASE_ASSET_BUCKET=rembr-assets
SUPABASE_IMPORT_BUCKET=rembr-imports
SUPABASE_MEDIA_BUCKET=rembr-media
SERVE_WEB=false
WEB_BUILD_DIRECTORY=apps/web/dist
ASSET_DIRECTORY=./data/assets
IMPORT_DIRECTORY=./data/imports
MEDIA_DIRECTORY=./data/media
MAX_CAPTURE_BYTES=2097152
MAX_CAPTURE_REDIRECTS=3
